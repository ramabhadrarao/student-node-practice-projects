# Root-level gitignore for student-node-practice-projects

# Node dependencies
backend/node_modules/
frontend/node_modules/

# Environment files
backend/.env
frontend/.env

# Logs
*.log
backend/logs/
frontend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs / coverage
backend/dist/
backend/build/
backend/coverage/
frontend/build/
frontend/coverage/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp